# Official OpenAI API used by the o3 planner.
OPENAI_API_KEY=

# Official Vertex AI Gemini endpoint. Include the project and location:
# https://aiplatform.googleapis.com/v1/projects/<project-id>/locations/<location>/publishers/google
GEMINI_BASE_URL=

# Choose either an API key or a service-account JSON file. Leave the unused
# setting empty. GOOGLE_APPLICATION_CREDENTIALS must be an absolute path.
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Local media is embedded by default. For GCS fileData, set this to gcs and
# configure both roots so local dataset paths can be mapped to gs:// URIs.
GEMINI_MEDIA_MODE=inline
GEMINI_LOCAL_DATA_ROOT=
GEMINI_GCS_DATA_ROOT=
